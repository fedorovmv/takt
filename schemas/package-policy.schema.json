{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takt.dev/schemas/package-policy.schema.json",
  "title": "Takt package source policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind"
  ],
  "properties": {
    "apiVersion": {
      "const": "takt/v1alpha1"
    },
    "kind": {
      "const": "PackagePolicy"
    },
    "allowed_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "require_signature_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "global",
          "corporate",
          "project"
        ]
      }
    },
    "trusted_keys": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
