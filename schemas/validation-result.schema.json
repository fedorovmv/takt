{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takt.dev/schemas/v1alpha1/validation-result.schema.json",
  "title": "Takt Validation Result v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "type", "valid"],
  "properties": {
    "protocol_version": {"const": "takt-validation/v1alpha1"},
    "type": {"const": "validation_result"},
    "valid": {"type": "boolean"},
    "score": {"type": "number", "minimum": 0, "maximum": 100},
    "checks": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/check"}
    },
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagnostic"}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passed": {"type": "boolean"},
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "weight": {"type": "number", "minimum": 0},
        "message": {"type": "string"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["info", "warning", "error"]},
        "path": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
