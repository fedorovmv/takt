{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takt.dev/schemas/schema-subset-description.schema.json",
  "title": "Takt schema subset description",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "types", "keywords", "enum_types", "additional_properties_modes", "pattern_dialect", "unsupported_keywords"],
  "properties": {
    "version": {"const": "takt-schema-subset/v1"},
    "types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "keywords": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "enum_types": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "additional_properties_modes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "pattern_dialect": {"type": "string", "minLength": 1},
    "unsupported_keywords": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
