{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takt.dev/schemas/evaluation-analysis.schema.json",
  "title": "Takt Evaluation Analysis Report v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "output_dir",
    "source_evaluation_dir",
    "status",
    "started_at",
    "finished_at",
    "duration_ms",
    "model",
    "selected_cases",
    "analyses"
  ],
  "properties": {
    "report_version": { "const": "takt-evaluation-analysis/v1alpha1" },
    "output_dir": { "type": "string", "minLength": 1 },
    "source_evaluation_dir": { "type": "string", "minLength": 1 },
    "status": { "enum": ["completed", "no_cases", "failed"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "language": { "enum": ["en", "ru"] },
    "trace_path": { "type": "string", "minLength": 1 },
    "model": { "$ref": "#/$defs/model" },
    "selected_cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case_ref" }
    },
    "analyses": {
      "type": "array",
      "items": { "$ref": "#/$defs/case_analysis" }
    }
  },
  "$defs": {
    "case_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "repeat"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "repeat": { "type": "integer", "minimum": 1 }
      }
    },
    "deterministic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string" },
        "outcome": { "type": "string" },
        "cause_source": { "type": "string" },
        "cause": { "type": "string" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "alias", "provider", "id"],
      "properties": {
        "preset": { "type": "string", "minLength": 1 },
        "alias": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "session_id", "session_evidence"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string" },
        "session_path": { "type": "string", "minLength": 1 },
        "session_evidence": { "enum": ["recorded", "unavailable"] },
        "session_evidence_path": { "type": "string", "minLength": 1 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cost", "duration_ms"],
      "properties": {
        "input_tokens": { "type": "number", "minimum": 0 },
        "output_tokens": { "type": "number", "minimum": 0 },
        "cost": { "type": "number", "minimum": 0 },
        "duration_ms": { "type": "number", "minimum": 0 }
      }
    },
    "causal_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact", "consequence", "evidence"],
      "properties": {
        "fact": { "type": "string", "minLength": 1 },
        "consequence": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "pointer", "fact"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "pointer": { "type": "string", "minLength": 1 },
        "fact": { "type": "string", "minLength": 1 }
      }
    },
    "disagreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["with_deterministic_cause", "explanation"],
      "properties": {
        "with_deterministic_cause": { "type": "boolean" },
        "explanation": { "type": "string" }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_class",
        "failure_mode",
        "confidence",
        "root_cause",
        "causal_mechanism",
        "failure_point",
        "prevention",
        "causal_chain",
        "evidence",
        "contributing_factors",
        "recommended_actions",
        "missing_evidence",
        "disagreement"
      ],
      "properties": {
        "primary_class": {
          "enum": ["infrastructure", "assistant", "workflow", "candidate", "validator", "task", "unknown"]
        },
        "failure_mode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "root_cause": { "type": "string", "minLength": 1 },
        "causal_mechanism": { "type": "string", "minLength": 1 },
        "failure_point": { "enum": ["assistant_decision", "workflow_control", "validator", "infrastructure", "unknown"] },
        "prevention": { "type": "string", "minLength": 1 },
        "causal_chain": { "type": "array", "items": { "$ref": "#/$defs/causal_link" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "contributing_factors": { "type": "array", "items": { "type": "string" } },
        "recommended_actions": { "type": "array", "items": { "type": "string" } },
        "missing_evidence": { "type": "array", "items": { "type": "string" } },
        "disagreement": { "$ref": "#/$defs/disagreement" }
      }
    },
    "case_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "repeat",
        "deterministic",
        "analysis_status",
        "model",
        "session",
        "usage",
        "evidence_fingerprint"
      ],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "repeat": { "type": "integer", "minimum": 1 },
        "deterministic": { "$ref": "#/$defs/deterministic" },
        "analysis_status": {
          "enum": ["completed", "provider_unavailable", "timed_out", "protocol", "persistence_error", "not_run"]
        },
        "analysis": { "$ref": "#/$defs/analysis" },
        "evidence_fingerprint": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string" },
        "prompt_fingerprint": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "raw_output_path": { "type": "string", "minLength": 1 },
        "model": { "$ref": "#/$defs/model" },
        "session": { "$ref": "#/$defs/session" },
        "usage": { "$ref": "#/$defs/usage" },
        "trace_path": { "type": "string", "minLength": 1 },
        "error_code": { "type": "string", "minLength": 1 },
        "error": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "analysis_status": { "const": "completed" } } },
          "then": { "required": ["analysis"] },
          "else": { "required": ["error_code", "error"] }
        }
      ]
    }
  }
}
