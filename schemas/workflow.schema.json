{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takt.dev/schemas/v1alpha1/workflow.schema.json",
  "title": "Takt Workflow v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "nodes"
  ],
  "properties": {
    "apiVersion": {
      "const": "takt/v1alpha1"
    },
    "kind": {
      "const": "Workflow"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "hooks": {
      "$ref": "#/$defs/hooks"
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assistant": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      }
    },
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "capture_response": {
          "type": "boolean"
        }
      }
    },
    "until": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node"
      ],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        },
        "output_contains": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "exit_code"
          ]
        },
        {
          "required": [
            "output_contains"
          ]
        }
      ]
    },
    "loopGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_iterations",
        "nodes",
        "until"
      ],
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/loopChildNode"
          }
        },
        "until": {
          "$ref": "#/$defs/until"
        }
      }
    },
    "hookDecision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "continue",
            "retry",
            "fail"
          ]
        },
        "session": {
          "type": "string"
        }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bash"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "bash": {
          "type": "string",
          "minLength": 1
        },
        "on_failure": {
          "$ref": "#/$defs/hookDecision"
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before_node": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook"
          }
        },
        "after_node": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook"
          }
        },
        "before_complete": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook"
          }
        },
        "on_failure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "when": {
          "type": "string"
        },
        "trigger_rule": {
          "enum": [
            "all_success",
            "all_done",
            "none_failed_min_one_success",
            "one_success"
          ]
        },
        "assistant": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "bash": {
          "type": "string"
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "loop_group": {
          "$ref": "#/$defs/loopGroup"
        },
        "attempts": {
          "$ref": "#/$defs/attempts"
        },
        "allow_failure": {
          "type": "boolean"
        },
        "hooks": {
          "$ref": "#/$defs/hooks"
        },
        "native_hooks": {},
        "timeout": {
          "type": "string",
          "description": "Go duration, for example 30s or 5m"
        },
        "subworkflow": {
          "$ref": "#/$defs/subworkflow"
        },
        "foreach": {
          "$ref": "#/$defs/foreach"
        },
        "output_format": {
          "$ref": "#/$defs/outputFormat"
        }
      },
      "oneOf": [
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "prompt"
          ]
        },
        {
          "required": [
            "bash"
          ]
        },
        {
          "required": [
            "approval"
          ]
        },
        {
          "required": [
            "loop_group"
          ]
        },
        {
          "required": [
            "subworkflow"
          ]
        },
        {
          "required": [
            "foreach"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "subworkflow"
            ]
          },
          "then": {
            "properties": {
              "attempts": {
                "properties": {
                  "max": {
                    "const": 0
                  }
                }
              },
              "allow_failure": {
                "const": false
              },
              "hooks": {
                "type": "object",
                "properties": {
                  "before_node": {
                    "maxItems": 0
                  },
                  "after_node": {
                    "maxItems": 0
                  },
                  "before_complete": {
                    "maxItems": 0
                  },
                  "on_failure": {
                    "maxItems": 0
                  }
                }
              },
              "timeout": {
                "maxLength": 0
              }
            },
            "not": {
              "required": [
                "native_hooks"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "foreach"
            ]
          },
          "then": {
            "properties": {
              "attempts": {
                "properties": {
                  "max": {
                    "const": 0
                  }
                }
              },
              "allow_failure": {
                "const": false
              },
              "hooks": {
                "type": "object",
                "properties": {
                  "before_node": {
                    "maxItems": 0
                  },
                  "after_node": {
                    "maxItems": 0
                  },
                  "before_complete": {
                    "maxItems": 0
                  },
                  "on_failure": {
                    "maxItems": 0
                  }
                }
              },
              "timeout": {
                "maxLength": 0
              }
            },
            "not": {
              "required": [
                "native_hooks"
              ]
            }
          }
        }
      ]
    },
    "loopChildNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "when": {
          "type": "string"
        },
        "trigger_rule": {
          "enum": [
            "all_success",
            "all_done",
            "none_failed_min_one_success",
            "one_success"
          ]
        },
        "assistant": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "bash": {
          "type": "string"
        },
        "attempts": {
          "$ref": "#/$defs/attempts"
        },
        "allow_failure": {
          "type": "boolean"
        },
        "hooks": {
          "$ref": "#/$defs/hooks"
        },
        "native_hooks": {},
        "timeout": {
          "type": "string",
          "description": "Go duration, for example 30s or 5m"
        },
        "subworkflow": {
          "$ref": "#/$defs/subworkflow"
        },
        "foreach": {
          "$ref": "#/$defs/foreach"
        },
        "output_format": {
          "$ref": "#/$defs/outputFormat"
        }
      },
      "oneOf": [
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "prompt"
          ]
        },
        {
          "required": [
            "bash"
          ]
        },
        {
          "required": [
            "subworkflow"
          ]
        },
        {
          "required": [
            "foreach"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "subworkflow"
            ]
          },
          "then": {
            "properties": {
              "attempts": {
                "properties": {
                  "max": {
                    "const": 0
                  }
                }
              },
              "allow_failure": {
                "const": false
              },
              "hooks": {
                "type": "object",
                "properties": {
                  "before_node": {
                    "maxItems": 0
                  },
                  "after_node": {
                    "maxItems": 0
                  },
                  "before_complete": {
                    "maxItems": 0
                  },
                  "on_failure": {
                    "maxItems": 0
                  }
                }
              },
              "timeout": {
                "maxLength": 0
              }
            },
            "not": {
              "required": [
                "native_hooks"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "foreach"
            ]
          },
          "then": {
            "properties": {
              "attempts": {
                "properties": {
                  "max": {
                    "const": 0
                  }
                }
              },
              "allow_failure": {
                "const": false
              },
              "hooks": {
                "type": "object",
                "properties": {
                  "before_node": {
                    "maxItems": 0
                  },
                  "after_node": {
                    "maxItems": 0
                  },
                  "before_complete": {
                    "maxItems": 0
                  },
                  "on_failure": {
                    "maxItems": 0
                  }
                }
              },
              "timeout": {
                "maxLength": 0
              }
            },
            "not": {
              "required": [
                "native_hooks"
              ]
            }
          }
        }
      ]
    },
    "subworkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "output_node": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "foreach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subworkflow"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {}
        },
        "as": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "subworkflow": {
          "$ref": "#/$defs/subworkflow"
        },
        "items_from": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "parallel": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "required": [
            "items"
          ]
        },
        {
          "required": [
            "items_from"
          ]
        }
      ]
    },
    "outputFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "boolean",
            "number",
            "integer"
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/outputFormat"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "enum": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "items": {
          "$ref": "#/$defs/outputFormat"
        },
        "additionalProperties": {
          "type": "boolean"
        }
      }
    }
  }
}
