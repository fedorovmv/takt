{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takt.dev/schemas/v1alpha1/workflow.schema.json",
  "title": "Takt Workflow v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "nodes"
  ],
  "properties": {
    "apiVersion": {
      "const": "takt/v1alpha1"
    },
    "kind": {
      "const": "Workflow"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "hooks": {
      "$ref": "#/$defs/hooks"
    },
    "worktree": {
      "$ref": "#/$defs/worktree"
    },
    "input": {
      "$ref": "#/$defs/inputContract"
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assistant": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      }
    },
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "retry_on": {
          "type": "array",
          "items": {
            "enum": [
              "exit",
              "start",
              "protocol",
              "internal"
            ]
          },
          "uniqueItems": true
        },
        "retry_session": {
          "enum": [
            "fresh",
            "reuse"
          ]
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "capture_response": {
          "type": "boolean"
        }
      }
    },
    "until": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node"
      ],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        },
        "output_contains": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "exit_code"
          ]
        },
        {
          "required": [
            "output_contains"
          ]
        }
      ]
    },
    "loopGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_iterations",
        "nodes",
        "until"
      ],
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/loopChildNode"
          }
        },
        "until": {
          "$ref": "#/$defs/until"
        }
      }
    },
    "hookDecision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "continue",
            "retry",
            "fail"
          ]
        },
        "session": {
          "type": "string"
        }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bash"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "bash": {
          "type": "string",
          "minLength": 1
        },
        "on_failure": {
          "$ref": "#/$defs/hookDecision"
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before_node": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook"
          }
        },
        "after_node": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook"
          }
        },
        "before_complete": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook"
          }
        },
        "on_failure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "when": {
          "type": "string"
        },
        "trigger_rule": {
          "enum": [
            "all_success",
            "all_done",
            "none_failed_min_one_success",
            "one_success"
          ]
        },
        "assistant": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "bash": {
          "type": "string"
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "loop_group": {
          "$ref": "#/$defs/loopGroup"
        },
        "attempts": {
          "$ref": "#/$defs/attempts"
        },
        "allow_failure": {
          "type": "boolean"
        },
        "always_run": {
          "type": "boolean",
          "description": "Run after dependencies become terminal even if one failed or was cancelled; equivalent to trigger_rule: all_done."
        },
        "hooks": {
          "$ref": "#/$defs/hooks"
        },
        "native_hooks": {},
        "timeout": {
          "type": "string",
          "description": "Go duration, for example 30s or 5m"
        },
        "idle_timeout": {
          "type": "string",
          "description": "Maximum time without normalized assistant activity; Go duration such as 30s or 5m."
        },
        "subworkflow": {
          "$ref": "#/$defs/subworkflow"
        },
        "foreach": {
          "$ref": "#/$defs/foreach"
        },
        "output_format": {
          "$ref": "#/$defs/outputFormat"
        },
        "workflow": {
          "$ref": "#/$defs/workflowRun"
        },
        "allowed_tools": {
          "$ref": "#/$defs/stringSet"
        },
        "denied_tools": {
          "$ref": "#/$defs/stringSet"
        },
        "skills": {
          "$ref": "#/$defs/stringSet"
        },
        "mcp": {
          "type": "string",
          "minLength": 1
        },
        "sandbox": {
          "$ref": "#/$defs/sandbox"
        },
        "requires": {
          "$ref": "#/$defs/stringSet"
        },
        "script": {
          "$ref": "#/$defs/script"
        },
        "output_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "output_mime": {
          "type": "string",
          "pattern": "^[^\\r\\n]+/[^\\r\\n]+$"
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        },
        "executor": {
          "enum": [
            "external"
          ]
        },
        "tool_approval": {
          "$ref": "#/$defs/toolApproval"
        },
        "side_effect": {
          "$ref": "#/$defs/sideEffect"
        },
        "adapter": {
          "$ref": "#/$defs/adapterCall"
        }
      },
      "oneOf": [
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "prompt"
          ]
        },
        {
          "required": [
            "bash"
          ]
        },
        {
          "required": [
            "script"
          ]
        },
        {
          "required": [
            "approval"
          ]
        },
        {
          "required": [
            "loop_group"
          ]
        },
        {
          "required": [
            "subworkflow"
          ]
        },
        {
          "required": [
            "foreach"
          ]
        },
        {
          "required": [
            "workflow"
          ]
        },
        {
          "required": [
            "adapter"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "subworkflow"
            ]
          },
          "then": {
            "properties": {
              "attempts": {
                "properties": {
                  "max": {
                    "const": 0
                  },
                  "retry_on": {
                    "maxItems": 0
                  },
                  "retry_session": {
                    "maxLength": 0
                  }
                }
              },
              "allow_failure": {
                "const": false
              },
              "hooks": {
                "type": "object",
                "properties": {
                  "before_node": {
                    "maxItems": 0
                  },
                  "after_node": {
                    "maxItems": 0
                  },
                  "before_complete": {
                    "maxItems": 0
                  },
                  "on_failure": {
                    "maxItems": 0
                  }
                }
              },
              "timeout": {
                "maxLength": 0
              },
              "allowed_tools": {
                "maxItems": 0
              },
              "denied_tools": {
                "maxItems": 0
              },
              "skills": {
                "maxItems": 0
              },
              "mcp": {
                "maxLength": 0
              },
              "requires": {
                "maxItems": 0
              }
            },
            "not": {
              "required": [
                "native_hooks",
                "sandbox"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "foreach"
            ]
          },
          "then": {
            "properties": {
              "attempts": {
                "properties": {
                  "max": {
                    "const": 0
                  },
                  "retry_on": {
                    "maxItems": 0
                  },
                  "retry_session": {
                    "maxLength": 0
                  }
                }
              },
              "allow_failure": {
                "const": false
              },
              "hooks": {
                "type": "object",
                "properties": {
                  "before_node": {
                    "maxItems": 0
                  },
                  "after_node": {
                    "maxItems": 0
                  },
                  "before_complete": {
                    "maxItems": 0
                  },
                  "on_failure": {
                    "maxItems": 0
                  }
                }
              },
              "timeout": {
                "maxLength": 0
              },
              "allowed_tools": {
                "maxItems": 0
              },
              "denied_tools": {
                "maxItems": 0
              },
              "skills": {
                "maxItems": 0
              },
              "mcp": {
                "maxLength": 0
              },
              "requires": {
                "maxItems": 0
              }
            },
            "not": {
              "required": [
                "native_hooks",
                "sandbox"
              ]
            }
          }
        }
      ]
    },
    "loopChildNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "when": {
          "type": "string"
        },
        "trigger_rule": {
          "enum": [
            "all_success",
            "all_done",
            "none_failed_min_one_success",
            "one_success"
          ]
        },
        "assistant": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "bash": {
          "type": "string"
        },
        "attempts": {
          "$ref": "#/$defs/attempts"
        },
        "allow_failure": {
          "type": "boolean"
        },
        "always_run": {
          "type": "boolean",
          "description": "Run after dependencies become terminal even if one failed or was cancelled; equivalent to trigger_rule: all_done."
        },
        "hooks": {
          "$ref": "#/$defs/hooks"
        },
        "native_hooks": {},
        "timeout": {
          "type": "string",
          "description": "Go duration, for example 30s or 5m"
        },
        "idle_timeout": {
          "type": "string",
          "description": "Maximum time without normalized assistant activity; Go duration such as 30s or 5m."
        },
        "subworkflow": {
          "$ref": "#/$defs/subworkflow"
        },
        "foreach": {
          "$ref": "#/$defs/foreach"
        },
        "output_format": {
          "$ref": "#/$defs/outputFormat"
        },
        "workflow": {
          "$ref": "#/$defs/workflowRun"
        },
        "allowed_tools": {
          "$ref": "#/$defs/stringSet"
        },
        "denied_tools": {
          "$ref": "#/$defs/stringSet"
        },
        "skills": {
          "$ref": "#/$defs/stringSet"
        },
        "mcp": {
          "type": "string",
          "minLength": 1
        },
        "sandbox": {
          "$ref": "#/$defs/sandbox"
        },
        "requires": {
          "$ref": "#/$defs/stringSet"
        },
        "script": {
          "$ref": "#/$defs/script"
        },
        "output_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "output_mime": {
          "type": "string",
          "pattern": "^[^\\r\\n]+/[^\\r\\n]+$"
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        },
        "executor": {
          "enum": [
            "external"
          ]
        },
        "tool_approval": {
          "$ref": "#/$defs/toolApproval"
        },
        "side_effect": {
          "$ref": "#/$defs/sideEffect"
        },
        "adapter": {
          "$ref": "#/$defs/adapterCall"
        }
      },
      "oneOf": [
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "prompt"
          ]
        },
        {
          "required": [
            "bash"
          ]
        },
        {
          "required": [
            "script"
          ]
        },
        {
          "required": [
            "subworkflow"
          ]
        },
        {
          "required": [
            "foreach"
          ]
        },
        {
          "required": [
            "workflow"
          ]
        },
        {
          "required": [
            "adapter"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "subworkflow"
            ]
          },
          "then": {
            "properties": {
              "attempts": {
                "properties": {
                  "max": {
                    "const": 0
                  }
                }
              },
              "allow_failure": {
                "const": false
              },
              "hooks": {
                "type": "object",
                "properties": {
                  "before_node": {
                    "maxItems": 0
                  },
                  "after_node": {
                    "maxItems": 0
                  },
                  "before_complete": {
                    "maxItems": 0
                  },
                  "on_failure": {
                    "maxItems": 0
                  }
                }
              },
              "timeout": {
                "maxLength": 0
              },
              "allowed_tools": {
                "maxItems": 0
              },
              "denied_tools": {
                "maxItems": 0
              },
              "skills": {
                "maxItems": 0
              },
              "mcp": {
                "maxLength": 0
              },
              "requires": {
                "maxItems": 0
              }
            },
            "not": {
              "required": [
                "native_hooks",
                "sandbox"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "foreach"
            ]
          },
          "then": {
            "properties": {
              "attempts": {
                "properties": {
                  "max": {
                    "const": 0
                  }
                }
              },
              "allow_failure": {
                "const": false
              },
              "hooks": {
                "type": "object",
                "properties": {
                  "before_node": {
                    "maxItems": 0
                  },
                  "after_node": {
                    "maxItems": 0
                  },
                  "before_complete": {
                    "maxItems": 0
                  },
                  "on_failure": {
                    "maxItems": 0
                  }
                }
              },
              "timeout": {
                "maxLength": 0
              },
              "allowed_tools": {
                "maxItems": 0
              },
              "denied_tools": {
                "maxItems": 0
              },
              "skills": {
                "maxItems": 0
              },
              "mcp": {
                "maxLength": 0
              },
              "requires": {
                "maxItems": 0
              }
            },
            "not": {
              "required": [
                "native_hooks",
                "sandbox"
              ]
            }
          }
        }
      ]
    },
    "subworkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "output_node": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "foreach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subworkflow"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {}
        },
        "as": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "subworkflow": {
          "$ref": "#/$defs/subworkflow"
        },
        "items_from": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "parallel": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "required": [
            "items"
          ]
        },
        {
          "required": [
            "items_from"
          ]
        }
      ]
    },
    "outputFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "boolean",
            "number",
            "integer"
          ]
        },
        "description": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/outputFormat"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "enum": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "items": {
          "$ref": "#/$defs/outputFormat"
        },
        "additionalProperties": {
          "type": "boolean"
        },
        "minProperties": {
          "type": "integer",
          "minimum": 0
        },
        "maxProperties": {
          "type": "integer",
          "minimum": 0
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "uniqueItems": {
          "type": "boolean"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "pattern": {
          "type": "string",
          "format": "regex"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "base": {
          "type": "string"
        },
        "branch_prefix": {
          "type": "string"
        },
        "cleanup": {
          "enum": [
            "on_success",
            "manual"
          ]
        },
        "allow_dirty": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": false
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "base"
                  ]
                },
                {
                  "required": [
                    "branch_prefix"
                  ]
                },
                {
                  "required": [
                    "cleanup"
                  ]
                },
                {
                  "required": [
                    "allow_dirty"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "workflowRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string"
        },
        "output_node": {
          "type": "string"
        },
        "isolation": {
          "enum": [
            "inherit",
            "worktree",
            "none"
          ]
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "fan_out": {
          "$ref": "#/$defs/workflowFanOut"
        }
      }
    },
    "stringSet": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filesystem": {
          "const": "read_only"
        },
        "network": {
          "const": "deny"
        }
      },
      "minProperties": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_tools": {
          "$ref": "#/$defs/stringSet"
        },
        "denied_tools": {
          "$ref": "#/$defs/stringSet"
        },
        "skills": {
          "$ref": "#/$defs/stringSet"
        },
        "mcp": {
          "type": "string",
          "minLength": 1
        },
        "sandbox": {
          "$ref": "#/$defs/sandbox"
        },
        "requires": {
          "$ref": "#/$defs/stringSet"
        }
      },
      "minProperties": 1
    },
    "workflowFanOut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items_from"
      ],
      "properties": {
        "items_from": {
          "type": "string",
          "pattern": "^nodes\\.[A-Za-z0-9_-]+\\.output(?:\\.[A-Za-z0-9_.-]+)?$"
        },
        "as": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "max_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "join": {
          "enum": [
            "all_success",
            "all_done",
            "one_success"
          ]
        },
        "allow_empty": {
          "type": "boolean"
        },
        "allow_duplicates": {
          "type": "boolean"
        }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime"
      ],
      "properties": {
        "runtime": {
          "enum": [
            "command",
            "python",
            "node",
            "go",
            "validation"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "inline": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "working_directory": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "runtime": {
                "const": "validation"
              }
            },
            "required": [
              "runtime"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "inline"
                  ]
                },
                {
                  "required": [
                    "args"
                  ]
                },
                {
                  "required": [
                    "dependencies"
                  ]
                }
              ]
            }
          },
          "else": {
            "if": {
              "properties": {
                "runtime": {
                  "enum": [
                    "command",
                    "go"
                  ]
                }
              },
              "required": [
                "runtime"
              ]
            },
            "then": {
              "required": [
                "path"
              ],
              "not": {
                "required": [
                  "inline"
                ]
              }
            },
            "else": {
              "oneOf": [
                {
                  "required": [
                    "path"
                  ],
                  "not": {
                    "required": [
                      "inline"
                    ]
                  }
                },
                {
                  "required": [
                    "inline"
                  ],
                  "not": {
                    "required": [
                      "path"
                    ]
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "inputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "enum": [
            "text",
            "markdown",
            "json"
          ]
        },
        "schema": {
          "$ref": "#/$defs/outputFormat"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "json"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "required": [
              "schema"
            ]
          },
          "else": {
            "not": {
              "required": [
                "schema"
              ]
            }
          }
        }
      ]
    },
    "toolApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "required"
        },
        "tools": {
          "$ref": "#/$defs/stringSet"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sideEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "idempotent",
            "reconcile"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adapterCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "operation"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*$"
        },
        "input": {
          "type": "string"
        }
      }
    }
  }
}
