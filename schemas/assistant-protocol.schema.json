{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takt.dev/schemas/v1alpha1/assistant-protocol.schema.json",
  "title": "Takt Assistant Protocol v1alpha1",
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provider",
        "id"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "sessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "fresh",
            "resume"
          ]
        },
        "id": {
          "type": "string"
        }
      }
    },
    "sessionResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "resumed": {
          "type": "boolean"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "run_id",
        "node_id",
        "attempt",
        "prompt",
        "workspace",
        "model",
        "session"
      ],
      "properties": {
        "protocol_version": {
          "enum": [
            "takt-assistant/v1alpha1",
            "takt-assistant/v1alpha2"
          ]
        },
        "type": {
          "const": "request"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "prompt": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "session": {
          "$ref": "#/$defs/sessionRequest"
        },
        "native_hooks": {},
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout_ms": {
              "type": "integer",
              "minimum": 0
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "policy": {
          "$ref": "#/$defs/policy"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "status",
        "exit_code"
      ],
      "properties": {
        "protocol_version": {
          "enum": [
            "takt-assistant/v1alpha1",
            "takt-assistant/v1alpha2"
          ]
        },
        "type": {
          "const": "result"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "output": {
          "type": "string"
        },
        "structured": {},
        "session": {
          "$ref": "#/$defs/sessionResult"
        },
        "exit_code": {
          "type": "integer"
        },
        "resolved_model": {
          "$ref": "#/$defs/model"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "not": {
                  "const": 0
                }
              }
            }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "denied_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tools_restricted": {
          "type": "boolean"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "skills_restricted": {
          "type": "boolean"
        },
        "mcp_path": {
          "type": "string"
        },
        "mcp_config": {},
        "filesystem": {
          "enum": [
            "read_only"
          ]
        },
        "network": {
          "enum": [
            "deny"
          ]
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "capabilityDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol"
      ],
      "properties": {
        "protocol": {
          "const": "takt-agent-events/v2"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "event_types": {
          "type": "array",
          "items": {
            "enum": [
              "session.started",
              "session.resumed",
              "message",
              "tool.requested",
              "tool.allowed",
              "tool.denied",
              "tool.started",
              "tool.completed",
              "artifact.declared",
              "usage",
              "diagnostic",
              "completed",
              "failed"
            ]
          },
          "uniqueItems": true
        },
        "session_events": {
          "type": "boolean"
        },
        "tool_events": {
          "type": "boolean"
        },
        "tool_control": {
          "type": "boolean"
        },
        "artifact_events": {
          "type": "boolean"
        },
        "usage_events": {
          "type": "boolean"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "session.started",
            "session.resumed",
            "message",
            "tool.requested",
            "tool.allowed",
            "tool.denied",
            "tool.started",
            "tool.completed",
            "artifact.declared",
            "usage",
            "diagnostic",
            "completed",
            "failed"
          ]
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "message": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "call_id": {
          "type": "string"
        },
        "input": {},
        "output": {},
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "artifact": {
          "type": "object"
        },
        "decision": {
          "enum": [
            "allow",
            "deny",
            "cancel"
          ]
        },
        "reason": {
          "type": "string"
        },
        "data": {
          "type": "object"
        },
        "provider": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      }
    },
    "toolRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "tool"
      ],
      "properties": {
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "input": {},
        "message": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      }
    },
    "toolDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision"
      ],
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "streamMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type"
      ],
      "properties": {
        "protocol_version": {
          "const": "takt-assistant/v1alpha2"
        },
        "type": {
          "enum": [
            "capabilities",
            "event",
            "tool.request",
            "result"
          ]
        },
        "declaration": {
          "$ref": "#/$defs/capabilityDeclaration"
        },
        "event": {
          "$ref": "#/$defs/event"
        },
        "tool_request": {
          "$ref": "#/$defs/toolRequest"
        },
        "result": {
          "$ref": "#/$defs/result"
        }
      }
    },
    "toolDecisionMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "call_id",
        "decision"
      ],
      "properties": {
        "protocol_version": {
          "const": "takt-assistant/v1alpha2"
        },
        "type": {
          "const": "tool.decision"
        },
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "$ref": "#/$defs/toolDecision"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/streamMessage"
    },
    {
      "$ref": "#/$defs/toolDecisionMessage"
    }
  ]
}
