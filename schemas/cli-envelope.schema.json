{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takt.local/schemas/cli-envelope.schema.json",
  "title": "Takt CLI JSON envelope",
  "description": "Stable top-level JSON envelope emitted by Takt CLI commands when JSON output is enabled.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "result"],
      "properties": {
        "ok": {"const": true},
        "result": {}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error"],
      "properties": {
        "ok": {"const": false},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable", "details"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1},
            "retryable": {"type": "boolean"},
            "details": {"type": "object"}
          }
        }
      }
    }
  ]
}
