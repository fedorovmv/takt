{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takt.dev/schemas/evaluation-stats.schema.json",
  "title": "Takt Evaluation Stats v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version", "mode", "workflow", "output_dir", "started_at", "finished_at",
    "strategy", "benchmark", "total", "valid", "invalid", "attempts", "assistant_executions",
    "retry_scheduled", "resumed_nodes", "infrastructure_errors", "input_tokens",
    "output_tokens", "total_tokens", "duration_ms", "cost", "average_time_to_valid_ms",
    "usage_by_execution_identity", "outcomes", "diagnostics", "cases", "assistant_steps", "assistant_sessions"
  ],
  "properties": {
    "report_version": {"const": "takt-evaluation-stats/v1alpha1"},
    "status": {"enum": ["running", "completed", "failed"]},
    "complete": {"type": "boolean"},
    "mode": {"type": "string"},
    "workflow": {"type": "string"},
    "output_dir": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "strategy": {"$ref": "#/$defs/strategy"},
    "benchmark": {"$ref": "#/$defs/benchmark"},
    "total": {"type": "integer", "minimum": 0},
    "valid": {"type": "integer", "minimum": 0},
    "invalid": {"type": "integer", "minimum": 0},
    "attempts": {"type": "integer", "minimum": 0},
    "assistant_executions": {"type": "integer", "minimum": 0},
    "retry_scheduled": {"type": "integer", "minimum": 0},
    "resumed_nodes": {"type": "integer", "minimum": 0},
    "infrastructure_errors": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "total_tokens": {"type": "integer", "minimum": 0},
    "duration_ms": {"type": "integer", "minimum": 0},
    "cost": {"type": "number", "minimum": 0},
    "average_time_to_valid_ms": {"type": ["number", "null"], "minimum": 0},
    "usage_by_execution_identity": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/usage"}
    },
    "flow": {"$ref": "#/$defs/flow"},
    "outcomes": {"$ref": "#/$defs/counts"},
    "diagnostics": {"$ref": "#/$defs/counts"},
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"}
    },
    "assistant_steps": {
      "type": "array",
      "items": {"$ref": "#/$defs/assistantStep"}
    },
    "assistant_sessions": {
      "type": "array",
      "items": {"$ref": "#/$defs/assistantSession"}
    },
    "total_runs": {"type": "integer", "minimum": 0},
    "completed_runs": {"type": "integer", "minimum": 0},
    "current": {"$ref": "#/$defs/current"},
    "timings": {"$ref": "#/$defs/timings"}
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "workflow_fingerprint", "config_fingerprint", "commands_fingerprint"],
      "properties": {
        "id": {"type": "string"},
        "fingerprint": {"type": "string"},
        "workflow_fingerprint": {"type": "string"},
        "config_fingerprint": {"type": "string"},
        "commands_fingerprint": {"type": "string"},
        "model_preset": {"type": "string"},
        "models": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "dataset_fingerprint", "workspace_fingerprint", "case_count", "validator"],
      "properties": {
        "id": {"type": "string"},
        "fingerprint": {"type": "string"},
        "dataset_fingerprint": {"type": "string"},
        "workspace_fingerprint": {"type": "string"},
        "case_count": {"type": "integer", "minimum": 0},
        "quality_node": {"type": "string"},
        "generation_node": {"type": "string"},
        "validation_protocol": {"type": "string"},
        "validator": {"$ref": "#/$defs/validator"},
        "case_manifest_fingerprint": {"type": "string"}
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "path": {"type": "string"},
        "fingerprint": {"type": "string"}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executions", "input_tokens", "output_tokens", "cost"],
      "properties": {
        "executions": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cost": {"type": "number", "minimum": 0}
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluated_runs", "flow_completed", "true_accept", "false_accept", "true_reject", "false_reject", "validation_errors", "infrastructure_errors", "valid_rate", "false_accept_rate", "false_reject_rate", "flow_completion_rate", "validation_error_rate"],
      "properties": {
        "evaluated_runs": {"type": "integer", "minimum": 0},
        "flow_completed": {"type": "integer", "minimum": 0},
        "true_accept": {"type": "integer", "minimum": 0},
        "false_accept": {"type": "integer", "minimum": 0},
        "true_reject": {"type": "integer", "minimum": 0},
        "false_reject": {"type": "integer", "minimum": 0},
        "validation_errors": {"type": "integer", "minimum": 0},
        "infrastructure_errors": {"type": "integer", "minimum": 0},
        "valid_rate": {"type": ["number", "null"]},
        "false_accept_rate": {"type": ["number", "null"]},
        "false_reject_rate": {"type": ["number", "null"]},
        "flow_completion_rate": {"type": ["number", "null"]},
        "validation_error_rate": {"type": ["number", "null"]}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "repeat", "status", "attempts", "input_tokens", "output_tokens", "duration_ms"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "repeat": {"type": "integer", "minimum": 1},
        "status": {"type": "string"},
        "outcome": {"type": "string"},
        "cause_source": {"type": "string"},
        "cause": {"type": "string"},
        "attempts": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0},
        "time_to_valid_ms": {"type": "integer", "minimum": 0}
      }
    },
    "assistantStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "repeat", "step", "model", "executions", "input_tokens", "output_tokens", "duration_ms"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "repeat": {"type": "integer", "minimum": 1},
        "step": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "executions": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "assistantSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "repeat", "step", "attempt", "provider_attempt", "resumed", "session_id"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "repeat": {"type": "integer", "minimum": 1},
        "step": {"type": "string", "minLength": 1},
        "attempt": {"type": "integer", "minimum": 0},
        "provider_attempt": {"type": "integer", "minimum": 0},
        "resumed": {"type": "boolean"},
        "session_id": {"type": "string", "minLength": 1}
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "repeat", "ordinal", "phase"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "repeat": {"type": "integer", "minimum": 1},
        "ordinal": {"type": "integer", "minimum": 1},
        "phase": {"enum": ["prepare", "validator_preflight", "workflow", "validator", "evidence", "cleanup", "finalized"]},
        "phase_started_at": {"type": "string", "format": "date-time"}
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phases", "assistant"],
      "properties": {
        "phases": {"$ref": "#/$defs/phaseTimings"},
        "assistant": {"$ref": "#/$defs/assistantTimings"}
      }
    },
    "phaseTimings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prepare_ms", "validator_preflight_ms", "workflow_ms", "validator_ms", "evidence_ms", "cleanup_ms"],
      "properties": {
        "prepare_ms": {"type": "integer", "minimum": 0},
        "validator_preflight_ms": {"type": "integer", "minimum": 0},
        "workflow_ms": {"type": "integer", "minimum": 0},
        "validator_ms": {"type": "integer", "minimum": 0},
        "evidence_ms": {"type": "integer", "minimum": 0},
        "cleanup_ms": {"type": "integer", "minimum": 0}
      }
    },
    "assistantTimings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wait_ms", "stream_ms", "total_ms", "tool_ms"],
      "properties": {
        "wait_ms": {"type": "integer", "minimum": 0},
        "stream_ms": {"type": "integer", "minimum": 0},
        "total_ms": {"type": "integer", "minimum": 0},
        "tool_ms": {"type": "integer", "minimum": 0}
      }
    }
  }
}
