{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takt.dev/schemas/v1alpha1/config.schema.json",
  "title": "Takt Config v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind"
  ],
  "properties": {
    "apiVersion": {
      "const": "takt/v1alpha1"
    },
    "kind": {
      "const": "Config"
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/model"
      }
    },
    "assistants": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/assistant"
      }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "id"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object"
        }
      }
    },
    "assistant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "mock",
            "process",
            "pi"
          ]
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "protocol": {
          "enum": [
            "takt-assistant/v1alpha1"
          ]
        },
        "binary": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "session_dir": {
          "type": "string",
          "minLength": 1
        },
        "project_trust": {
          "enum": [
            "default",
            "approve",
            "deny"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "process"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "argv"
            ],
            "properties": {
              "argv": {
                "minItems": 1
              },
              "binary": false,
              "args": false,
              "session_dir": false,
              "project_trust": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "mock"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "protocol": false,
              "binary": false,
              "args": false,
              "session_dir": false,
              "project_trust": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pi"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "argv": false,
              "protocol": false
            }
          }
        }
      ]
    }
  }
}
