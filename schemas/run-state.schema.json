{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takt.dev/schemas/v1alpha1/run-state.schema.json",
  "title": "Takt Run State v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "workflow_path",
    "config_path",
    "workspace",
    "input",
    "nodes",
    "approvals",
    "created_at",
    "updated_at",
    "revision"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "running",
        "waiting",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "workflow_path": {
      "type": "string"
    },
    "config_path": {
      "type": "string"
    },
    "workspace": {
      "type": "string"
    },
    "input": {
      "type": "string"
    },
    "current_node": {
      "type": "string"
    },
    "waiting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "message"
      ],
      "properties": {
        "node_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "approval",
            "child_run",
            "external_node"
          ]
        },
        "child_run_id": {
          "type": "string"
        },
        "child_run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/nodeState"
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "string"
    },
    "workflow_fingerprint": {
      "type": "string"
    },
    "config_fingerprint": {
      "type": "string"
    },
    "commands_fingerprint": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "error_code": {
      "type": "string"
    },
    "execution_workspace": {
      "type": "string"
    },
    "current_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "worktree": {
      "$ref": "#/$defs/worktreeState"
    },
    "run_options": {
      "$ref": "#/$defs/runOptions"
    },
    "parent_run_id": {
      "type": "string"
    },
    "parent_node_id": {
      "type": "string"
    },
    "child_run_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "output": {
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "cancel_requested": {
      "type": "boolean"
    },
    "inherited_policy": {
      "$ref": "#/$defs/policyState"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    }
  },
  "$defs": {
    "nodeState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "running",
            "waiting",
            "completed",
            "failed",
            "errored",
            "cancelled",
            "timed_out",
            "skipped",
            "blocked"
          ]
        },
        "output": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "feedback": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "resumed": {
          "type": "boolean"
        },
        "loop_previous": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/nodeState"
          }
        },
        "output_truncated": {
          "type": "boolean"
        },
        "error_code": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "assistant": {
          "type": "string"
        },
        "assistant_version": {
          "type": "string"
        },
        "requested_model": {
          "$ref": "#/$defs/modelRef"
        },
        "resolved_model": {
          "$ref": "#/$defs/modelRef"
        },
        "executions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executionState"
          }
        },
        "internal": {
          "type": "boolean"
        },
        "public_parent": {
          "type": "string"
        },
        "child_run_id": {
          "type": "string"
        },
        "child_run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "policy": {
          "$ref": "#/$defs/policyState"
        },
        "child_runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/childRunItemState"
          }
        },
        "fan_out_attempt": {
          "type": "integer",
          "minimum": 0
        },
        "fan_out_fingerprint": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        },
        "external": {
          "$ref": "#/$defs/externalExecutionState"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "modelRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "executionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "status"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "errored",
            "cancelled",
            "timed_out"
          ]
        },
        "assistant": {
          "type": "string"
        },
        "assistant_version": {
          "type": "string"
        },
        "requested_model": {
          "$ref": "#/$defs/modelRef"
        },
        "resolved_model": {
          "$ref": "#/$defs/modelRef"
        },
        "session_id": {
          "type": "string"
        },
        "resumed": {
          "type": "boolean"
        },
        "exit_code": {
          "type": "integer"
        },
        "error_code": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "output_truncated": {
          "type": "boolean"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        }
      }
    },
    "worktreeState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "repository_root": {
          "type": "string"
        },
        "control_workspace": {
          "type": "string"
        },
        "execution_workspace": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "base_ref": {
          "type": "string"
        },
        "base_commit": {
          "type": "string"
        },
        "cleanup": {
          "enum": [
            "on_success",
            "manual"
          ]
        },
        "base_dirty": {
          "type": "boolean"
        },
        "dirty": {
          "type": "boolean"
        },
        "removed": {
          "type": "boolean"
        },
        "retained_reason": {
          "type": "string"
        },
        "cleanup_error": {
          "type": "string"
        },
        "removed_at": {
          "type": "string",
          "format": "date-time"
        },
        "branch_removed": {
          "type": "boolean"
        },
        "branch_cleanup_error": {
          "type": "string"
        }
      }
    },
    "runOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worktree_mode": {
          "enum": [
            "auto",
            "enabled",
            "disabled"
          ]
        },
        "worktree_base": {
          "type": "string"
        },
        "keep_worktree": {
          "type": "boolean"
        },
        "allow_dirty_worktree": {
          "type": "boolean"
        }
      }
    },
    "policyState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "denied_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "tools_restricted": {
          "type": "boolean"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "skills_restricted": {
          "type": "boolean"
        },
        "mcp_path": {
          "type": "string"
        },
        "filesystem": {
          "enum": [
            "read_only"
          ]
        },
        "network": {
          "enum": [
            "deny"
          ]
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "childRunItemState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "index",
        "item",
        "item_fingerprint",
        "run_id",
        "status"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "item": {},
        "item_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "error_code": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "mime",
        "path",
        "sha256",
        "size",
        "producer_run_id",
        "producer_node_id",
        "attempt",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "producer_run_id": {
          "type": "string"
        },
        "producer_node_id": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "externalResultState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output": {
          "type": "string"
        },
        "structured": {},
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "session_id": {
          "type": "string"
        },
        "resumed": {
          "type": "boolean"
        },
        "assistant_version": {
          "type": "string"
        },
        "resolved_model": {
          "$ref": "#/$defs/modelRef"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "error_code": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "externalExecutionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "attempt",
        "prompt",
        "workspace"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "claimed",
            "completed",
            "failed"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "prompt": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "assistant": {
          "type": "string"
        },
        "requested_model": {
          "$ref": "#/$defs/modelRef"
        },
        "session_mode": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/policyState"
        },
        "output_format": {},
        "claimed_by": {
          "type": "string"
        },
        "claim_token": {
          "type": "string"
        },
        "lease_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_event_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "$ref": "#/$defs/externalResultState"
        }
      }
    }
  }
}
