{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takt.dev/schemas/v1alpha1/run-state.schema.json",
  "title": "Takt Run State v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "workflow_path",
    "config_path",
    "workspace",
    "input",
    "nodes",
    "approvals",
    "created_at",
    "updated_at",
    "revision"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "running",
        "pausing",
        "paused",
        "waiting",
        "completed",
        "failed",
        "cancelled",
        "abandoned"
      ]
    },
    "workflow_path": {
      "type": "string"
    },
    "workflow_contract": {
      "const": "takt-flow/v1alpha1"
    },
    "config_path": {
      "type": "string"
    },
    "workspace": {
      "type": "string"
    },
    "input": {
      "type": "string"
    },
    "current_node": {
      "type": "string"
    },
    "waiting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "message"
      ],
      "properties": {
        "node_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "approval",
            "child_run",
            "external_node"
          ]
        },
        "child_run_id": {
          "type": "string"
        },
        "child_run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/nodeState"
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "string"
    },
    "workflow_fingerprint": {
      "type": "string"
    },
    "config_fingerprint": {
      "type": "string"
    },
    "commands_fingerprint": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "error_code": {
      "type": "string"
    },
    "execution_workspace": {
      "type": "string"
    },
    "current_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "worktree": {
      "$ref": "#/$defs/worktreeState"
    },
    "run_options": {
      "$ref": "#/$defs/runOptions"
    },
    "parent_run_id": {
      "type": "string"
    },
    "parent_node_id": {
      "type": "string"
    },
    "child_run_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "output": {
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "cancel_requested": {
      "type": "boolean"
    },
    "cancel_source": {
      "type": "string"
    },
    "cancel_node_path": {
      "type": "string"
    },
    "cancel_iteration": {
      "type": "integer",
      "minimum": 0
    },
    "cancel_reason": {
      "type": "string"
    },
    "pause_requested": {
      "type": "boolean"
    },
    "paused_at": {
      "type": "string",
      "format": "date-time"
    },
    "paused_from": {
      "type": "string"
    },
    "abandoned_at": {
      "type": "string",
      "format": "date-time"
    },
    "abandon_reason": {
      "type": "string"
    },
    "recovery_count": {
      "type": "integer",
      "minimum": 0
    },
    "last_recovered_at": {
      "type": "string",
      "format": "date-time"
    },
    "executor_pid": {
      "type": "integer",
      "minimum": 0
    },
    "heartbeat_at": {
      "type": "string",
      "format": "date-time"
    },
    "operator_retries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operatorRetryState"
      }
    },
    "inherited_policy": {
      "$ref": "#/$defs/policyState"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    }
  },
  "$defs": {
    "nodeState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "running",
            "waiting",
            "completed",
            "failed",
            "errored",
            "cancelled",
            "timed_out",
            "skipped",
            "blocked"
          ]
        },
        "output": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "provider_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "feedback": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "session_path": {
          "type": "string"
        },
        "resumed": {
          "type": "boolean"
        },
        "loop_previous": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/nodeState"
          }
        },
        "output_truncated": {
          "type": "boolean"
        },
        "error_code": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "assistant": {
          "type": "string"
        },
        "adapter": {
          "type": "string"
        },
        "assistant_version": {
          "type": "string"
        },
        "requested_model": {
          "$ref": "#/$defs/modelRef"
        },
        "resolved_model": {
          "$ref": "#/$defs/modelRef"
        },
        "executions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executionState"
          }
        },
        "internal": {
          "type": "boolean"
        },
        "public_parent": {
          "type": "string"
        },
        "child_run_id": {
          "type": "string"
        },
        "child_run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "policy": {
          "$ref": "#/$defs/policyState"
        },
        "child_runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/childRunItemState"
          }
        },
        "fan_out_attempt": {
          "type": "integer",
          "minimum": 0
        },
        "fan_out_fingerprint": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        },
        "external": {
          "$ref": "#/$defs/externalExecutionState"
        },
        "domain_operation": {
          "$ref": "#/$defs/domainOperationState"
        },
        "child_control_workspace": {
          "type": "string",
          "description": "Control workspace used by a governed child Run."
        },
        "child_execution_workspace": {
          "type": "string",
          "description": "Execution workspace/worktree used by a governed child Run."
        },
        "child_branch": {
          "type": "string",
          "description": "Managed child worktree branch."
        },
        "child_base_commit": {
          "type": "string",
          "description": "Base commit of the managed child worktree."
        },
        "path": {
          "type": "string",
          "pattern": "^/",
          "description": "Canonical structured node path; internal legacy node IDs remain stable."
        },
        "diagnostic": {
          "$ref": "#/$defs/diagnosticState"
        },
        "retry": {
          "$ref": "#/$defs/retryState"
        },
        "sandbox": {
          "$ref": "#/$defs/sandboxState"
        },
        "loop_iterations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loopIterationState"
          },
          "maxItems": 64
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "modelRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "executionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "status"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "provider_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "errored",
            "cancelled",
            "timed_out"
          ]
        },
        "assistant": {
          "type": "string"
        },
        "adapter": {
          "type": "string"
        },
        "assistant_version": {
          "type": "string"
        },
        "requested_model": {
          "$ref": "#/$defs/modelRef"
        },
        "resolved_model": {
          "$ref": "#/$defs/modelRef"
        },
        "session_id": {
          "type": "string"
        },
        "session_path": {
          "type": "string"
        },
        "resumed": {
          "type": "boolean"
        },
        "exit_code": {
          "type": "integer"
        },
        "error_code": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "output_truncated": {
          "type": "boolean"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "diagnostic": {
          "$ref": "#/$defs/diagnosticState"
        }
      }
    },
    "worktreeState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "repository_root": {
          "type": "string"
        },
        "control_workspace": {
          "type": "string"
        },
        "execution_workspace": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "base_ref": {
          "type": "string"
        },
        "base_commit": {
          "type": "string"
        },
        "cleanup": {
          "enum": [
            "on_success",
            "manual"
          ]
        },
        "base_dirty": {
          "type": "boolean"
        },
        "dirty": {
          "type": "boolean"
        },
        "removed": {
          "type": "boolean"
        },
        "retained_reason": {
          "type": "string"
        },
        "cleanup_error": {
          "type": "string"
        },
        "removed_at": {
          "type": "string",
          "format": "date-time"
        },
        "branch_removed": {
          "type": "boolean"
        },
        "branch_cleanup_error": {
          "type": "string"
        }
      }
    },
    "runOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worktree_mode": {
          "enum": [
            "auto",
            "enabled",
            "disabled"
          ]
        },
        "worktree_base": {
          "type": "string"
        },
        "keep_worktree": {
          "type": "boolean"
        },
        "allow_dirty_worktree": {
          "type": "boolean"
        },
        "model_preset": {
          "type": "string",
          "minLength": 1
        },
        "model_overrides": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^/\\s]+/.+$"
          }
        }
      }
    },
    "policyState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "denied_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "tools_restricted": {
          "type": "boolean"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "skills_restricted": {
          "type": "boolean"
        },
        "mcp_path": {
          "type": "string"
        },
        "filesystem": {
          "enum": [
            "read_only"
          ]
        },
        "network": {
          "enum": [
            "deny"
          ]
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "childRunItemState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "index",
        "item",
        "item_fingerprint",
        "run_id",
        "status"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "item": {},
        "item_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "error_code": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        },
        "cancel_reason": {
          "type": "string"
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "mime",
        "path",
        "sha256",
        "size",
        "producer_run_id",
        "producer_node_id",
        "attempt",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "producer_run_id": {
          "type": "string"
        },
        "producer_node_id": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "call_id": {
          "type": "string"
        }
      }
    },
    "externalResultState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output": {
          "type": "string"
        },
        "structured": {},
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "session_id": {
          "type": "string"
        },
        "resumed": {
          "type": "boolean"
        },
        "assistant_version": {
          "type": "string"
        },
        "resolved_model": {
          "$ref": "#/$defs/modelRef"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "error_code": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "externalExecutionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "attempt",
        "prompt",
        "workspace"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "claimed",
            "completed",
            "failed"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "prompt": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "assistant": {
          "type": "string"
        },
        "requested_model": {
          "$ref": "#/$defs/modelRef"
        },
        "session_mode": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/policyState"
        },
        "output_format": {},
        "claimed_by": {
          "type": "string"
        },
        "claimed_at": {
          "type": "string",
          "format": "date-time"
        },
        "claim_token": {
          "type": "string"
        },
        "lease_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "idle_timeout": {
          "type": "string"
        },
        "last_activity_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_event_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "$ref": "#/$defs/externalResultState"
        },
        "capability_declaration": {
          "type": "object"
        },
        "tool_approval": {
          "type": "object"
        },
        "tool_calls": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "side_effect_mode": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "receipt": {
          "type": "string"
        },
        "reconcile_status": {
          "type": "string"
        }
      }
    },
    "operatorRetryState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "requested_at",
        "previous_status",
        "previous_attempts"
      ],
      "properties": {
        "node_id": {
          "type": "string"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "previous_status": {
          "type": "string"
        },
        "previous_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "previous_error": {
          "type": "string"
        }
      }
    },
    "domainOperationState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "domain",
        "operation"
      ],
      "properties": {
        "adapter": {
          "type": "string"
        },
        "domain": {
          "enum": [
            "scm",
            "tracker",
            "ci"
          ]
        },
        "operation": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reconcile_supported": {
          "type": "boolean"
        },
        "side_effect_mode": {
          "enum": [
            "idempotent",
            "reconcile"
          ]
        },
        "idempotency_key": {
          "type": "string"
        },
        "receipt": {
          "type": "string"
        },
        "reconcile_status": {
          "enum": [
            "applied",
            "not_applied",
            "unknown"
          ]
        }
      }
    },
    "diagnosticState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "kind",
        "message",
        "fingerprint"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "op": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "retryState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_attempt",
        "not_before",
        "delay"
      ],
      "properties": {
        "next_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "not_before": {
          "type": "string",
          "format": "date-time"
        },
        "delay": {
          "type": "string",
          "pattern": "^(?:0|(?:[0-9]+(?:ns|us|µs|ms|s|m|h))+)$"
        },
        "scope": {
          "enum": [
            "workflow",
            "provider"
          ]
        },
        "provider_attempt": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3
        },
        "attempt_deadline": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "provider"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "provider_attempt": {
                "minimum": 2,
                "maximum": 3
              }
            },
            "required": ["provider_attempt"]
          }
        }
      ]
    },
    "sandboxState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "status": {
          "enum": [
            "enforced",
            "degraded",
            "not_requested"
          ]
        },
        "backend": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "loopIterationState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iteration",
        "nodes",
        "until_node",
        "exit_code",
        "status",
        "satisfied",
        "completed_at"
      ],
      "properties": {
        "iteration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/nodeState"
          }
        },
        "until_node": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "satisfied": {
          "type": "boolean"
        },
        "matched_signal": {
          "type": ["string", "null"]
        },
        "signal_diagnostic": {
          "enum": ["signal_missing", "signal_ambiguous", null]
        },
        "until_bash": {
          "$ref": "#/$defs/predicateEvidence"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "predicateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "duration", "terminal_status"],
      "properties": {
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "exit_code": {"type": "integer"},
        "duration": {"type": "integer", "minimum": 0},
        "terminal_status": {"type": "string"},
        "truncated": {"type": "boolean"},
        "error_code": {"type": "string"}
      }
    }
  }
}
