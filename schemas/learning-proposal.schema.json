{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takt.local/schemas/learning-proposal.schema.json",
  "title": "Takt human-reviewed learning proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "status", "pattern", "candidate", "expected_benefit", "created_at", "updated_at"],
  "properties": {
    "apiVersion": {"const": "takt-learning/v1alpha1"},
    "kind": {"const": "LearningProposal"},
    "id": {"type": "string", "pattern": "^learn-[0-9a-f]{24}$"},
    "status": {"enum": ["pending_review", "accepted", "rejected", "evaluation_failed", "ready"]},
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fingerprint", "count", "run_ids", "summary"],
      "properties": {
        "kind": {"enum": ["diagnostic", "workflow_success"]},
        "fingerprint": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 2},
        "run_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "summary": {"type": "string", "minLength": 1},
        "workflow_path": {"type": "string"},
        "node_id": {"type": "string"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "snapshot_path", "sha256"],
      "properties": {
        "kind": {"enum": ["skill", "block"]},
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "snapshot_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "expected_benefit": {"type": "string", "minLength": 1},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason", "at"],
      "properties": {
        "decision": {"enum": ["accept", "reject"]},
        "reason": {"type": "string", "minLength": 1},
        "at": {"type": "string", "minLength": 1}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_version", "report_sha256", "matrix_fingerprint", "benchmark_id", "gate_count", "passed", "at"],
      "properties": {
        "report_version": {"enum": ["takt-evaluation-matrix/v1alpha1", "takt-task-evaluation-matrix/v1alpha1"]},
        "report_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "matrix_fingerprint": {"type": "string", "minLength": 1},
        "benchmark_id": {"type": "string", "minLength": 1},
        "gate_count": {"type": "integer", "minimum": 1},
        "passed": {"type": "boolean"},
        "at": {"type": "string", "minLength": 1}
      }
    },
    "ready_path": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
