{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takt.dev/schemas/block-package.schema.json",
  "title": "Takt trusted block package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "blocks"
  ],
  "properties": {
    "apiVersion": {
      "const": "takt/v1alpha1"
    },
    "kind": {
      "const": "BlockPackage"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "scope"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "builtin",
            "global",
            "corporate",
            "project"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/role"
      }
    },
    "blocks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/block"
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "requirements": {
      "$ref": "#/$defs/requirements"
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "output_paths"
      ],
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/stringArray"
        },
        "integrations": {
          "$ref": "#/$defs/stringArray"
        },
        "output_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_checks": {
          "$ref": "#/$defs/stringArray"
        },
        "policy": {
          "type": "object"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_blocks": {
          "$ref": "#/$defs/stringArray"
        },
        "required_checks": {
          "$ref": "#/$defs/stringArray"
        },
        "allowed_integrations": {
          "allOf": [
            {
              "$ref": "#/$defs/stringArray"
            }
          ],
          "description": "Absent means no package restriction; an explicit empty list denies every integration."
        },
        "branch_rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefix": {
              "type": "string"
            },
            "pattern": {
              "type": "string"
            },
            "require_clean_base": {
              "type": "boolean"
            }
          }
        },
        "change_request_template": {
          "type": "string"
        },
        "policy": {
          "type": "object"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_child_runs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256,
              "description": "Zero adds no package-level upper bound; the effective dynamic plan remains bounded."
            },
            "max_parallel": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64,
              "description": "Zero adds no package-level upper bound; the effective dynamic plan remains bounded."
            },
            "max_iterations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16,
              "description": "Zero adds no package-level upper bound; the effective dynamic plan remains bounded."
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000,
              "description": "Zero adds no package-level upper bound; the effective dynamic plan remains bounded."
            }
          }
        }
      }
    },
    "contextRecipe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "$ref": "#/$defs/stringArray"
        },
        "max_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "pathScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected": {
          "$ref": "#/$defs/stringArray"
        },
        "allowed": {
          "$ref": "#/$defs/stringArray"
        },
        "protected": {
          "$ref": "#/$defs/stringArray"
        },
        "forbidden": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "type": "string"
        },
        "model_profile": {
          "type": "string"
        },
        "session": {
          "enum": [
            "fresh",
            "shared"
          ]
        },
        "context": {
          "$ref": "#/$defs/contextRecipe"
        },
        "paths": {
          "$ref": "#/$defs/pathScope"
        },
        "policy": {
          "type": "object"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "level",
        "reaction"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "required",
            "preferred"
          ]
        },
        "reaction": {
          "enum": [
            "deny",
            "repair",
            "warn"
          ]
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Exact, >=, ^, or * package version constraint."
        }
      }
    },
    "adapterRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "domain"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "domain": {
          "enum": [
            "scm",
            "tracker",
            "ci"
          ]
        },
        "operations": {
          "$ref": "#/$defs/stringArray"
        },
        "reconcile": {
          "$ref": "#/$defs/stringArray"
        },
        "level": {
          "enum": [
            "required",
            "preferred"
          ]
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "takt": {
          "type": "string",
          "minLength": 1,
          "description": "Exact, >=, ^, or * Takt compatibility constraint."
        },
        "adapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adapterRequirement"
          }
        }
      }
    }
  }
}
