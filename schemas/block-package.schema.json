{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takt.dev/schemas/block-package.schema.json",
  "title": "Takt trusted block package",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "blocks"],
  "properties": {
    "apiVersion": {"const": "takt/v1alpha1"},
    "kind": {"const": "BlockPackage"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "scope"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "version": {"type": "string", "minLength": 1},
        "scope": {"enum": ["builtin", "corporate", "project"]},
        "description": {"type": "string"}
      }
    },
    "blocks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,62}$"},
      "additionalProperties": {"$ref": "#/$defs/block"}
    },
    "templates": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "governance": {"$ref": "#/$defs/governance"}
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "output_paths"],
      "properties": {
        "workflow": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "capabilities": {"$ref": "#/$defs/stringArray"},
        "integrations": {"$ref": "#/$defs/stringArray"},
        "output_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_checks": {"$ref": "#/$defs/stringArray"},
        "policy": {"type": "object"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_blocks": {"$ref": "#/$defs/stringArray"},
        "required_checks": {"$ref": "#/$defs/stringArray"},
        "allowed_integrations": {"$ref": "#/$defs/stringArray"},
        "branch_rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefix": {"type": "string"},
            "pattern": {"type": "string"},
            "require_clean_base": {"type": "boolean"}
          }
        },
        "change_request_template": {"type": "string"},
        "policy": {"type": "object"},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_child_runs": {"type": "integer", "minimum": 1, "maximum": 256},
            "max_parallel": {"type": "integer", "minimum": 1, "maximum": 64},
            "max_iterations": {"type": "integer", "minimum": 1, "maximum": 16},
            "max_tokens": {"type": "integer", "minimum": 1, "maximum": 100000000}
          }
        }
      }
    }
  }
}
