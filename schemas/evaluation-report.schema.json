{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takt.dev/schemas/v1alpha1/evaluation-report.schema.json",
  "title": "Takt Evaluation Report v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "takt_version",
    "started_at",
    "finished_at",
    "duration_ms",
    "workflow",
    "config",
    "cases_dir",
    "output_dir",
    "strategy",
    "benchmark",
    "environment",
    "runs",
    "summary"
  ],
  "properties": {
    "report_version": {
      "const": "takt-evaluation/v1alpha1"
    },
    "takt_version": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "workflow": {
      "type": "string"
    },
    "config": {
      "type": "string"
    },
    "cases_dir": {
      "type": "string"
    },
    "output_dir": {
      "type": "string"
    },
    "strategy": {
      "$ref": "#/$defs/strategy"
    },
    "benchmark": {
      "$ref": "#/$defs/benchmark"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "mode": {
      "const": "flow"
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fingerprint",
        "workflow_fingerprint",
        "config_fingerprint",
        "commands_fingerprint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "workflow_fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "config_fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "commands_fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "model_preset": {
          "type": "string",
          "minLength": 1
        },
        "models": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^/\\s]+/\\S+$"
          }
        }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fingerprint",
        "dataset_fingerprint",
        "workspace_fingerprint",
        "case_count",
        "validator"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "dataset_fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "workspace_fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "quality_node": {
          "type": "string"
        },
        "generation_node": {
          "type": "string"
        },
        "validation_protocol": {
          "type": "string"
        },
        "validator": {
          "$ref": "#/$defs/validator"
        },
        "case_manifest_fingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goos",
        "goarch",
        "go_version"
      ],
      "properties": {
        "goos": {
          "type": "string"
        },
        "goarch": {
          "type": "string"
        },
        "go_version": {
          "type": "string"
        },
        "path_sha256": {
          "$ref": "#/$defs/fingerprint"
        },
        "oracle_metadata_sha256": {
          "$ref": "#/$defs/fingerprint"
        },
        "assistant_idle_timeout": {
          "type": "string"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "executions",
        "exit_code",
        "mixed_execution_identity",
        "output_truncated",
        "resumed",
        "status"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "provider_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "assistant": {
          "type": "string"
        },
        "assistant_version": {
          "type": "string"
        },
        "requested_model": {
          "$ref": "#/$defs/model"
        },
        "resolved_model": {
          "$ref": "#/$defs/model"
        },
        "session_id": {
          "type": "string"
        },
        "resumed": {
          "type": "boolean"
        },
        "exit_code": {
          "type": "integer"
        },
        "error_code": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "feedback": {
          "type": "string"
        },
        "diagnostic_output": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "output_truncated": {
          "type": "boolean"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "mixed_execution_identity": {
          "type": "boolean"
        },
        "executions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/execution"
          }
        },
        "diagnostic": {
          "$ref": "#/$defs/diagnostic"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answers",
        "attempts",
        "attempts_to_valid",
        "case_id",
        "cost",
        "duration_ms",
        "input_tokens",
        "mixed_execution_identity_nodes",
        "nodes",
        "output_tokens",
        "quality_expected",
        "repeat",
        "resumed_nodes",
        "status",
        "truncated_nodes",
        "valid_at_first_attempt",
        "workspace",
        "time_to_valid_ms",
        "retry_scheduled"
      ],
      "properties": {
        "case_id": {
          "type": "string"
        },
        "repeat": {
          "type": "integer",
          "minimum": 1
        },
        "run_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "provider_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "attempts_to_valid": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "valid_at_first_attempt": {
          "type": "boolean"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "answers": {
          "type": "integer",
          "minimum": 0
        },
        "truncated_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "resumed_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "error_code": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/validationResult"
        },
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/node"
          }
        },
        "quality_error": {
          "type": "string"
        },
        "mixed_execution_identity_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "quality_expected": {
          "type": "boolean"
        },
        "quality_node_status": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "time_to_valid_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "retry_scheduled": {
          "type": "integer",
          "minimum": 0
        },
        "retry_fingerprints": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "mode": {
          "const": "flow"
        },
        "validation": {
          "$ref": "#/$defs/flowValidation"
        },
        "outcome": {
          "enum": ["true_accept", "false_accept", "true_reject", "false_reject", "infrastructure_error"]
        },
        "run_passed": {
          "type": ["boolean", "null"]
        },
        "cleanup": {
          "$ref": "#/$defs/flowCleanup"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amortized_end_to_end_ms_per_valid",
        "answers",
        "attempts",
        "average_attempts_to_valid",
        "average_score",
        "by_assistant",
        "by_assistant_version",
        "by_requested_model",
        "by_resolved_model",
        "by_status",
        "cost",
        "cost_per_valid",
        "diagnostics_by_code",
        "diagnostics_by_severity",
        "duration_ms",
        "final_success_rate",
        "input_tokens",
        "infrastructure_errors",
        "invalid",
        "mixed_execution_identity_nodes",
        "output_tokens",
        "quality_runs",
        "resumed_nodes",
        "scored_runs",
        "success_at_1",
        "total",
        "truncated_nodes",
        "usage_by_execution_identity",
        "valid",
        "valid_at_first_attempt",
        "diagnostics_by_fingerprint",
        "average_time_to_valid_ms",
        "retry_scheduled",
        "failed_executions",
        "failed_execution_cost",
        "stable_valid_cases",
        "stable_invalid_cases",
        "unstable_cases"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "by_status": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "infrastructure_errors": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "answers": {
          "type": "integer",
          "minimum": 0
        },
        "truncated_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "resumed_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "by_assistant": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_assistant_version": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_requested_model": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_resolved_model": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "quality_runs": {
          "type": "integer",
          "minimum": 0
        },
        "valid": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "valid_at_first_attempt": {
          "type": "integer",
          "minimum": 0
        },
        "success_at_1": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "final_success_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "average_attempts_to_valid": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "average_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "cost_per_valid": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "diagnostics_by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "diagnostics_by_code": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "usage_by_execution_identity": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/usageBreakdown"
          }
        },
        "mixed_execution_identity_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "scored_runs": {
          "type": "integer",
          "minimum": 0
        },
        "amortized_end_to_end_ms_per_valid": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "diagnostics_by_fingerprint": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "average_time_to_valid_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "retry_scheduled": {
          "type": "integer",
          "minimum": 0
        },
        "failed_executions": {
          "type": "integer",
          "minimum": 0
        },
        "failed_execution_cost": {
          "type": "number",
          "minimum": 0
        },
        "stable_valid_cases": {
          "type": "integer",
          "minimum": 0
        },
        "stable_invalid_cases": {
          "type": "integer",
          "minimum": 0
        },
        "unstable_cases": {
          "type": "integer",
          "minimum": 0
        },
        "flow": {
          "$ref": "#/$defs/flowSummary"
        }
      }
    },
    "flowValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "duration_ms"],
      "properties": {
        "status": {"type": "string"},
        "error_code": {"type": "string"},
        "error": {"type": "string"},
        "result": {"$ref": "#/$defs/validationResult"},
        "duration_ms": {"type": "integer", "minimum": 0}
      }
    },
    "flowCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"type": "string"},
        "error": {"type": "string"},
        "paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "flowSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluated_runs", "flow_completed", "true_accept", "false_accept", "true_reject", "false_reject", "validation_errors", "infrastructure_errors", "valid_rate", "false_accept_rate", "false_reject_rate", "flow_completion_rate", "validation_error_rate"],
      "properties": {
        "evaluated_runs": {"type": "integer", "minimum": 0},
        "flow_completed": {"type": "integer", "minimum": 0},
        "true_accept": {"type": "integer", "minimum": 0},
        "false_accept": {"type": "integer", "minimum": 0},
        "true_reject": {"type": "integer", "minimum": 0},
        "false_reject": {"type": "integer", "minimum": 0},
        "validation_errors": {"type": "integer", "minimum": 0},
        "infrastructure_errors": {"type": "integer", "minimum": 0},
        "valid_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "false_accept_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "false_reject_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "flow_completion_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "validation_error_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "status",
        "resumed",
        "exit_code",
        "output_truncated"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "provider_attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "status": {
          "type": "string"
        },
        "assistant": {
          "type": "string"
        },
        "assistant_version": {
          "type": "string"
        },
        "requested_model": {
          "$ref": "#/$defs/model"
        },
        "resolved_model": {
          "$ref": "#/$defs/model"
        },
        "session_id": {
          "type": "string"
        },
        "resumed": {
          "type": "boolean"
        },
        "exit_code": {
          "type": "integer"
        },
        "error_code": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "output_truncated": {
          "type": "boolean"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "diagnostic": {
          "$ref": "#/$defs/diagnostic"
        }
      }
    },
    "usageBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executions",
        "input_tokens",
        "output_tokens",
        "cost"
      ],
      "properties": {
        "executions": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "kind",
        "message",
        "fingerprint"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "op": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "valid"
      ],
      "properties": {
        "protocol_version": {
          "const": "takt-validation/v1alpha1"
        },
        "type": {
          "const": "validation_result"
        },
        "valid": {
          "type": "boolean"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "checks": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/validationResult_check"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validationResult_diagnostic"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "validationResult_check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "message": {
          "type": "string"
        }
      }
    },
    "validationResult_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
