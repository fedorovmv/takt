#!/usr/bin/env sh
set -eu

# This gate is active only in the isolated flow-evaluation fixture. Ordinary
# production runs use their configured SCM provider and have no fixture tree.
fixture_dir="${TAKT_WORKSPACE:-}/.takt/eval/scm-fixture"
if [ ! -d "$fixture_dir" ]; then
  exit 0
fi

calls_log="${TAKT_WORKSPACE}/.takt/evals/scm/calls.log"
if [ ! -f "$calls_log" ]; then
  printf '%s\n' 'required SCM side effect missing: gh pr create was not recorded' >&2
  exit 1
fi

create_count=$(awk '$1 == "pr" && $2 == "create" { count++ } END { print count + 0 }' "$calls_log")
if [ "$create_count" -ne 1 ]; then
  printf 'required exactly one SCM side effect: gh pr create count=%s\n' "$create_count" >&2
  exit 1
fi

count_file="${TAKT_WORKSPACE}/.takt/evals/scm/pr-count"
if [ ! -f "$count_file" ] || [ -L "$count_file" ] || [ "$(cat "$count_file")" != "1" ]; then
  printf '%s\n' 'required successful SCM receipt missing: pr-count must equal 1' >&2
  exit 1
fi
