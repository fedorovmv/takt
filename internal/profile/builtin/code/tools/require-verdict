#!/usr/bin/env sh
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  printf '%s\n' 'usage: require-verdict ARTIFACT [LABEL]' >&2
  exit 2
fi

artifact=$1
label=${2:-validation}
tool_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
"$tool_dir/require-artifacts" "$artifact"

if ! LC_ALL=C tr -d '\000' < "$artifact" | cmp -s - "$artifact"; then
  printf 'invalid %s verdict: binary data\n' "$label" >&2
  exit 1
fi

verdict=$(awk '
  /^verdict:/ {
    declared++
    if ($0 == "verdict: PASS") verdict = "PASS"
    else if ($0 == "verdict: REPAIR") verdict = "REPAIR"
    else if ($0 == "verdict: BLOCKED") verdict = "BLOCKED"
    else invalid = 1
  }
  END {
    if (declared != 1 || invalid || verdict == "") exit 1
    printf "%s", verdict
  }
' "$artifact") || {
  printf 'invalid %s verdict\n' "$label" >&2
  exit 1
}

printf '%s' "$verdict"
