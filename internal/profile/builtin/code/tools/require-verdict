#!/usr/bin/env sh
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  printf '%s\n' 'usage: require-verdict ARTIFACT [LABEL]' >&2
  exit 2
fi

artifact=$1
label=${2:-validation}
tool_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
"$tool_dir/require-artifacts" "$artifact"

if ! LC_ALL=C tr -d '\000' < "$artifact" | cmp -s - "$artifact"; then
  printf 'invalid %s verdict: binary data\n' "$label" >&2
  exit 1
fi

verdict=$(LC_ALL=C awk '
  {
    line = $0
    if (match(line, /^#+[ \t]+/)) {
      heading = substr(line, 1, RLENGTH)
      gsub(/[ \t]/, "", heading)
      line = substr(line, RLENGTH + 1)
      if (length(heading) > 6) {
        if (tolower(line) ~ /^verdict:/) {
          declared++
          invalid = 1
        }
        next
      }
    }
    line = tolower(line)
  }
  line ~ /^verdict:/ {
    declared++
    if (line == "verdict: pass") verdict = "PASS"
    else if (line == "verdict: repair") verdict = "REPAIR"
    else if (line == "verdict: blocked") verdict = "BLOCKED"
    else invalid = 1
  }
  END {
    if (declared != 1 || invalid || verdict == "") exit 1
    printf "%s", verdict
  }
' "$artifact") || {
  printf 'invalid %s verdict\n' "$label" >&2
  exit 1
}

printf '%s' "$verdict"
